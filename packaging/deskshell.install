post_install() {
    cat <<'MSG'
==> deskshell: nothing is enabled. As your user:
      systemctl --user enable --now deskshell.service
==> GPG touch waits: deskshell-gpg.service replaces yubikey-touch-detector.
      systemctl --user disable --now yubikey-touch-detector.socket yubikey-touch-detector.service
      systemctl --user enable --now deskshell-gpg.service
==> The greeter files are in /usr/share/deskshell/greetd and stay inactive until copied
    into /etc/greetd and /etc/tmpfiles.d by hand.
MSG
}

post_upgrade() {
    echo "==> deskshell: run 'systemctl --user restart deskshell.service' to use the new version"
}
