+/// Sets the [`DeviceHook`] for every compositor created afterwards. Only the
+/// first call takes effect. Returns whether this call set it.
+pub fn set_device_hook(hook: DeviceHook) -> bool {
+    DEVICE_HOOK.set(hook).is_ok()
