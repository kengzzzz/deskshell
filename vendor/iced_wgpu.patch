 use crate::settings::{self, Settings};
 use crate::{Engine, Renderer};
 
+/// Opens the device in place of `Adapter::request_device`.
+///
+/// `None` falls back to `request_device`. deskshell uses this to enable Vulkan
+/// extensions that wgpu does not request on its own. Not part of upstream iced.
+pub type DeviceHook = fn(
+    &wgpu::Adapter,
+    &wgpu::DeviceDescriptor<'_>,
+) -> Option<Result<(wgpu::Device, wgpu::Queue), wgpu::RequestDeviceError>>;
+
+static DEVICE_HOOK: std::sync::OnceLock<DeviceHook> = std::sync::OnceLock::new();
+
+/// Sets the [`DeviceHook`] for every compositor created afterwards. Only the
+/// first call takes effect. Returns whether this call set it.
+pub fn set_device_hook(hook: DeviceHook) -> bool {
+    DEVICE_HOOK.set(hook).is_ok()
+}
