+    fn unmap_layer(&self, id: id::Id, connection: &Connection) {
+        let Some(Shell::LayerShell(layer)) = self
+            .shells
+            .iter()
+            .find(|unit| unit.id == id)
+            .map(|unit| &unit.shell)
+        else {
+            return;
+        };
+        // A null buffer would unmap too, but the compositor's fade-out snapshot would be empty.
+        // Drop destroys the role again, which is a no-op on a dead proxy.
+        layer.destroy();
+        for _ in 0..50 {
+            match connection.flush() {
+                Err(wayland_backend::client::WaylandError::Io(err))
+                    if err.kind() == std::io::ErrorKind::WouldBlock =>
+                {
+                    std::thread::sleep(std::time::Duration::from_millis(2));
+                }
+                _ => return,
+            }
+        }
+    }
